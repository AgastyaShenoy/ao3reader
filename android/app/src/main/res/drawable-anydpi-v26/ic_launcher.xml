<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher masks this to its own shape; the plain drawable/ic_launcher.xml is the same mark on
     a rounded tile for anything that can't use adaptive icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/flax_blue" />
    <foreground android:drawable="@drawable/ic_launcher_mark" />
    <monochrome android:drawable="@drawable/ic_launcher_mark" />
</adaptive-icon>
